{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator.activation-aggregate.v2",
  "title": "ActivationAggregate.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_key", "generation", "release_candidate_digest", "project_bundle_manifest_digest", "native_squad_dispatch_digest", "primary_runtime_alias", "base_active_release_digest", "target_runtime_aliases", "receipts", "state", "aggregated_at", "aggregate_digest"],
  "properties": {
    "schema": {"const": "multica-orchestrator.activation-aggregate.v2"},
    "project_key": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "generation": {"type": "integer", "minimum": 1},
    "release_candidate_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "project_bundle_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "native_squad_dispatch_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "primary_runtime_alias": {"type": "string", "minLength": 1},
    "base_active_release_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "target_runtime_aliases": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "receipts": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "state": {"const": "VERIFIED"},
    "aggregated_at": {"type": "string", "format": "date-time"},
    "aggregate_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
