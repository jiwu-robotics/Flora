{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator-nail-down.project-binding-snapshot.v6",
  "title": "ProjectBindingSnapshot.v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "workspace_ref",
    "server_manifest_digest",
    "repository",
    "project",
    "runtime_targets",
    "primary_local_directory",
    "observed_at",
    "snapshot_digest"
  ],
  "properties": {
    "schema": {
      "const": "multica-orchestrator-nail-down.project-binding-snapshot.v6"
    },
    "workspace_ref": {
      "type": "string",
      "minLength": 1
    },
    "server_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "root",
        "registered",
        "repository_ref",
        "project_has_resource",
        "resource_ref"
      ],
      "properties": {
        "url": {
          "type": "string"
        },
        "root": {
          "type": "string",
          "pattern": "^/"
        },
        "registered": {
          "type": "boolean"
        },
        "repository_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_has_resource": {
          "type": "boolean"
        },
        "resource_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exists",
        "project_ref"
      ],
      "properties": {
        "exists": {
          "type": "boolean"
        },
        "project_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime_alias", "runtime_ref", "daemon_ref", "capability_revision"],
        "properties": {
          "runtime_alias": {"type": "string", "minLength": 1},
          "runtime_ref": {"type": "string", "minLength": 1},
          "daemon_ref": {"type": "string", "minLength": 1},
          "capability_revision": {"pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "primary_local_directory": {
      "type": "object"
    }
  }
}
