{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator-relocate.record.v3",
  "title": "RelocationRecord.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state_root", "deployment_key", "generation", "migration_receipt_digest", "plan_digest", "relocation_intent_digest", "aggregate_digest", "deployment_index_path", "source_index_digest", "target_index_digest", "target_inventory_digest", "old_server", "target_server", "old_workspace_key", "new_workspace_key", "workspace_ref", "target_identity_sets", "foundation_manifest_digest", "server_manifest_digest", "projects", "commit_authorization_ref", "state", "activation_state", "dispatch_state", "commit_readback_observed_at", "mutation_sequence", "committed_at", "record_digest"],
  "properties": {
    "schema": {"const": "multica-orchestrator-relocate.record.v3"},
    "state_root": {"type": "string", "pattern": "^/"},
    "deployment_key": {"$ref": "#/$defs/digest"},
    "generation": {"type": "integer", "minimum": 1},
    "migration_receipt_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "relocation_intent_digest": {"$ref": "#/$defs/digest"},
    "aggregate_digest": {"$ref": "#/$defs/digest"},
    "deployment_index_path": {"type": "string", "pattern": "^/"},
    "source_index_digest": {"$ref": "#/$defs/digest"},
    "target_index_digest": {"$ref": "#/$defs/digest"},
    "target_inventory_digest": {"$ref": "#/$defs/digest"},
    "old_server": {"$ref": "#/$defs/server"},
    "target_server": {"$ref": "#/$defs/server"},
    "old_workspace_key": {"$ref": "#/$defs/digest"},
    "new_workspace_key": {"$ref": "#/$defs/digest"},
    "workspace_ref": {"type": "string", "minLength": 1},
    "target_identity_sets": {"$ref": "#/$defs/identitySets"},
    "foundation_manifest_digest": {"$ref": "#/$defs/digest"},
    "server_manifest_digest": {"$ref": "#/$defs/digest"},
    "projects": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["old_project_key", "new_project_key", "receipt_digest"], "properties": {"old_project_key": {"$ref": "#/$defs/digest"}, "new_project_key": {"$ref": "#/$defs/digest"}, "receipt_digest": {"$ref": "#/$defs/digest"}}}},
    "commit_authorization_ref": {"type": "string", "pattern": "^approval:[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "state": {"const": "INDEX_COMMITTED"},
    "activation_state": {"const": "ACTIVE"},
    "dispatch_state": {"const": "BLOCKED_VERIFICATION_REQUIRED"},
    "commit_readback_observed_at": {"type": "string", "format": "date-time"},
    "mutation_sequence": {"type": "integer", "minimum": 1},
    "committed_at": {"type": "string", "format": "date-time"},
    "record_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "server": {"type": "object", "additionalProperties": false, "required": ["kind", "ref"], "properties": {"kind": {"enum": ["cloud", "self-hosted"]}, "ref": {"type": "string", "minLength": 1}}},
    "identitySets": {"type": "object", "additionalProperties": false, "required": ["workspace_digest", "project_set_digest", "orchestrator_resource_digest", "runtime_fleet_membership_digest"], "properties": {"workspace_digest": {"$ref": "#/$defs/digest"}, "project_set_digest": {"$ref": "#/$defs/digest"}, "orchestrator_resource_digest": {"$ref": "#/$defs/digest"}, "runtime_fleet_membership_digest": {"$ref": "#/$defs/digest"}}}
  }
}
