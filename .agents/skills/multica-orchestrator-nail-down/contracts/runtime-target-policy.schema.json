{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator.runtime-target-policy.v4",
  "title": "RuntimeTargetPolicy.v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "required_runtimes",
    "optional_runtimes",
    "native_squad_dispatch"
  ],
  "properties": {
    "schema": {
      "const": "multica-orchestrator.runtime-target-policy.v4"
    },
    "required_runtimes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "optional_runtimes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "native_squad_dispatch": {
      "$ref": "#/$defs/nativeSquadDispatch"
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_alias",
        "local_directory_required",
        "command_profile",
        "workload_classes",
        "required_capability_revision"
      ],
      "properties": {
        "runtime_alias": {
          "type": "string",
          "minLength": 1
        },
        "local_directory_required": {
          "type": "boolean"
        },
        "command_profile": {
          "type": "string",
          "minLength": 1
        },
        "workload_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "required_capability_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "nativeSquadDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leader_first",
        "leader_routes_by_exact_member_mention",
        "member_reply_retriggers_leader",
        "issue_assignment_no_start_required",
        "runtime_open_fence_required"
      ],
      "properties": {
        "leader_first": {
          "const": true
        },
        "leader_routes_by_exact_member_mention": {
          "const": true
        },
        "member_reply_retriggers_leader": {
          "const": true
        },
        "issue_assignment_no_start_required": {
          "const": true
        },
        "runtime_open_fence_required": {
          "const": true
        }
      }
    }
  }
}
