{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator-nail-down.project-binding-request.v6",
  "title": "ProjectBindingRequest.v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "repository",
    "policy",
    "command_profiles",
    "runtime_target_policy"
  ],
  "properties": {
    "schema": {
      "const": "multica-orchestrator-nail-down.project-binding-request.v6"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_subpath"
      ],
      "properties": {
        "project_subpath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "work_item_id_source",
        "runtime_branch_authority",
        "integration_branch_authority",
        "main_ref",
        "develop_ref",
        "repository_command_profile"
      ],
      "properties": {
        "execution_mode": {
          "const": "worktree"
        },
        "work_item_id_source": {
          "const": "multica-issue-key"
        },
        "runtime_branch_authority": {
          "const": "multica"
        },
        "integration_branch_authority": {
          "const": "repository-provider"
        },
        "main_ref": {
          "type": "string",
          "minLength": 1
        },
        "develop_ref": {
          "type": "string",
          "minLength": 1
        },
        "repository_command_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command_profiles": {
      "type": "object",
      "minProperties": 1
    },
    "runtime_target_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_runtimes",
        "optional_runtimes",
        "native_squad_dispatch"
      ],
      "properties": {
        "required_runtimes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/runtimeTarget"
          }
        },
        "optional_runtimes": {
          "type": "array",
          "maxItems": 0,
          "items": {
            "$ref": "#/$defs/runtimeTarget"
          }
        },
        "native_squad_dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "leader_first",
            "leader_routes_by_exact_member_mention",
            "member_reply_retriggers_leader",
            "issue_assignment_no_start_required",
            "runtime_open_fence_required"
          ],
          "properties": {
            "leader_first": {
              "const": true
            },
            "leader_routes_by_exact_member_mention": {
              "const": true
            },
            "member_reply_retriggers_leader": {
              "const": true
            },
            "issue_assignment_no_start_required": {
              "const": true
            },
            "runtime_open_fence_required": {
              "const": true
            }
          }
        }
      }
    }
  },
  "$defs": {
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_alias",
        "local_directory_required",
        "command_profile",
        "workload_classes",
        "required_capability_revision"
      ],
      "properties": {
        "runtime_alias": {
          "type": "string",
          "minLength": 1
        },
        "local_directory_required": {
          "const": true
        },
        "command_profile": {
          "type": "string",
          "minLength": 1
        },
        "workload_classes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "feature",
              "fix"
            ]
          },
          "uniqueItems": true
        },
        "required_capability_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
