{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator.project-release-candidate.v8",
  "title": "ProjectReleaseCandidate.v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deployment_key",
    "relocation_intent_digest",
    "project_key",
    "generation",
    "project_bundle_manifest_digest",
    "required_runtime_aliases",
    "native_squad_dispatch_digest",
    "runtime_capability_digest",
    "dispatch_contract_digest",
    "previous_release_digest",
    "predecessor",
    "repository_identity",
    "project_subpath",
    "produced_at"
  ],
  "properties": {
    "schema": {
      "const": "multica-orchestrator.project-release-candidate.v8"
    },
    "deployment_key": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "relocation_intent_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "project_key": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "project_bundle_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "required_runtime_aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "native_squad_dispatch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "previous_release_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "predecessor": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "relation",
        "project_key",
        "release_digest"
      ],
      "properties": {
        "relation": {
          "const": "server-relocation"
        },
        "project_key": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "repository_identity": {
      "type": "string",
      "pattern": "^github:[^/]+/[^/]+$"
    },
    "project_subpath": {
      "type": "string",
      "minLength": 1
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "runtime_capability_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "dispatch_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
