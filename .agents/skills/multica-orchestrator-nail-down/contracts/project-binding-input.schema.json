{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator-nail-down.project-binding-input.v12",
  "title": "Project binding application input v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "bundle_store",
    "server",
    "server_handoff_bundle",
    "repository",
    "project",
    "policy",
    "command_profiles",
    "runtime_target_policy",
    "primary_runtime",
    "local_directory_observation"
  ],
  "properties": {
    "schema": {
      "const": "multica-orchestrator-nail-down.project-binding-input.v12"
    },
    "bundle_store": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_root"
      ],
      "properties": {
        "state_root": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "deployment_key",
        "profile",
        "workspace_ref",
        "account_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cloud",
            "self-hosted"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "deployment_key": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workspace_key": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "workspace_ref": {
          "type": "string",
          "minLength": 1
        },
        "account_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "server_handoff_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest"
      ],
      "properties": {
        "manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "url",
        "root",
        "project_subpath",
        "registered",
        "project_has_resource"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "project_subpath": {
          "type": "string",
          "minLength": 1
        },
        "registered": {
          "type": "boolean"
        },
        "repository_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_has_resource": {
          "type": "boolean"
        },
        "resource_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "exists"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "project_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "work_item_id_source",
        "runtime_branch_authority",
        "integration_branch_authority",
        "main_ref",
        "develop_ref",
        "branch_policy_digest",
        "skill_profile_digest",
        "repository_command_profile"
      ],
      "properties": {
        "execution_mode": {
          "const": "worktree"
        },
        "work_item_id_source": {
          "const": "multica-issue-key"
        },
        "runtime_branch_authority": {
          "const": "multica"
        },
        "integration_branch_authority": {
          "const": "repository-provider"
        },
        "main_ref": {
          "type": "string",
          "minLength": 1
        },
        "develop_ref": {
          "type": "string",
          "minLength": 1
        },
        "branch_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "skill_profile_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "repository_command_profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "command_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test",
          "lint",
          "build"
        ],
        "properties": {
          "test": {
            "$ref": "#/$defs/commandPolicy"
          },
          "lint": {
            "$ref": "#/$defs/commandPolicy"
          },
          "build": {
            "$ref": "#/$defs/commandPolicy"
          }
        }
      }
    },
    "runtime_target_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_runtimes",
        "optional_runtimes",
        "native_squad_dispatch"
      ],
      "properties": {
        "required_runtimes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/runtimeTarget"
          }
        },
        "optional_runtimes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeTarget"
          }
        },
        "native_squad_dispatch": {
          "$ref": "#/$defs/nativeSquadDispatch"
        }
      }
    },
    "primary_runtime": {
      "type": "object"
    },
    "local_directory_observation": {
      "type": "object"
    }
  },
  "$defs": {
    "commandPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "na_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "na_policy_ref"
          ]
        }
      ]
    },
    "runtimeTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_alias",
        "local_directory_required",
        "command_profile",
        "workload_classes",
        "required_capability_revision"
      ],
      "properties": {
        "runtime_alias": {
          "type": "string",
          "minLength": 1
        },
        "local_directory_required": {
          "const": true
        },
        "command_profile": {
          "type": "string",
          "minLength": 1
        },
        "workload_classes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "feature",
              "fix"
            ]
          },
          "uniqueItems": true
        },
        "required_capability_revision": {
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "nativeSquadDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leader_first",
        "leader_routes_by_exact_member_mention",
        "member_reply_retriggers_leader",
        "issue_assignment_no_start_required",
        "runtime_open_fence_required"
      ],
      "properties": {
        "leader_first": {
          "const": true
        },
        "leader_routes_by_exact_member_mention": {
          "const": true
        },
        "member_reply_retriggers_leader": {
          "const": true
        },
        "issue_assignment_no_start_required": {
          "const": true
        },
        "runtime_open_fence_required": {
          "const": true
        }
      }
    }
  }
}
