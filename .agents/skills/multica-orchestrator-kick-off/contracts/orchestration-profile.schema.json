{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator.orchestration-profile.v1",
  "title": "Operator-local orchestration profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "collaboration_runtime_alias", "defaults", "model_groups", "roles"],
  "properties": {
    "schema": {"const": "multica-orchestrator.orchestration-profile.v1"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "collaboration_runtime_alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "defaults": {"$ref": "#/$defs/agent"},
    "model_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "minLength": 1},
        "uniqueItems": true
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/agent"}
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "thinking_level": {"type": ["string", "null"]},
        "max_concurrent_tasks": {"const": 1},
        "permission_mode": {"const": "private"}
      }
    }
  }
}
