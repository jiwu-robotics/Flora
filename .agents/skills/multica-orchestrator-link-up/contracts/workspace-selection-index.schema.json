{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator.workspace-selection-index.v1",
  "title": "Operator-local Workspace selection index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "selector_key", "deployment_key", "workspace_key", "updated_at"],
  "properties": {
    "schema": {"const": "multica-orchestrator.workspace-selection-index.v1"},
    "selector_key": {"$ref": "#/$defs/digest"},
    "deployment_key": {"$ref": "#/$defs/digest"},
    "workspace_key": {"$ref": "#/$defs/digest"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
