{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
"$id": "multica-orchestrator-migrate.input.v5",
"title": "MigrationInput.v5",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "server", "repository", "targets"],
  "properties": {
    "schema": {"const": "multica-orchestrator-migrate.input.v5"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["state_root", "operator_state_root", "project_bundle_manifest_digest", "release_candidate_path", "release_candidate_digest", "primary_runtime_alias", "source_active_release_digest"],
      "properties": {
        "state_root": {"type": "string", "pattern": "^/"},
        "operator_state_root": {"type": "string", "pattern": "^/"},
        "project_bundle_manifest_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "release_candidate_path": {"type": "string", "pattern": "^/"},
        "release_candidate_digest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "primary_runtime_alias": {"type": "string", "minLength": 1},
        "source_active_release_digest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "server": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ref", "workspace_ref"],
      "properties": {
        "kind": {"enum": ["cloud", "self-hosted"]},
        "ref": {"type": "string", "minLength": 1},
        "workspace_ref": {"type": "string", "minLength": 1},
        "deployment_key": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["url", "project_subpath"],
      "properties": {
        "url": {"type": "string", "minLength": 1},
        "project_subpath": {"type": "string", "minLength": 1}
      }
    },
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["runtime_alias", "ssh_config_host", "profile", "account_ref", "state_root", "repository_root", "remote_receipt_path", "coordinator_receipt_path"],
        "properties": {
          "runtime_alias": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "ssh_config_host": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "account_ref": {"type": "string", "minLength": 1},
          "state_root": {"type": "string", "pattern": "^/"},
          "repository_root": {"type": "string", "pattern": "^/"},
          "remote_receipt_path": {"type": "string", "pattern": "^/"},
          "coordinator_receipt_path": {"type": "string", "pattern": "^/"}
        }
      }
    }
  }
}
