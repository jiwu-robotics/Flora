{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "multica-orchestrator-relocate.intent.v2",
  "title": "RelocationIntent.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "deployment_key", "migration_receipt_digest", "plan_digest", "source_index_digest", "target_inventory_digest", "old_workspace_key", "new_workspace_key", "fence_readback_digest", "fence_readback_observed_at", "project_keys", "created_at", "intent_digest"],
  "properties": {
    "schema": {"const": "multica-orchestrator-relocate.intent.v2"},
    "deployment_key": {"$ref": "#/$defs/digest"},
    "migration_receipt_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "source_index_digest": {"$ref": "#/$defs/digest"},
    "target_inventory_digest": {"$ref": "#/$defs/digest"},
    "old_workspace_key": {"$ref": "#/$defs/digest"},
    "new_workspace_key": {"$ref": "#/$defs/digest"},
    "fence_readback_digest": {"$ref": "#/$defs/digest"},
    "fence_readback_observed_at": {"type": "string", "format": "date-time"},
    "project_keys": {"type": "array", "items": {"$ref": "#/$defs/digest"}, "uniqueItems": true},
    "created_at": {"type": "string", "format": "date-time"},
    "intent_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
